{
  "name": "moniveo-payments",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized payment orchestration service for Moniveo products",
  "type": "module",
  "engines": {
    "node": ">=20.19.4"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format cjs --target node20",
    "start": "node dist/server.cjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/contract",
    "test:integration": "vitest run tests/integration tests/e2e",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "check:domain": "tsx scripts/check-domain-boundary.ts",
    "service-client:create": "tsx scripts/create-service-client.ts",
    "secrets:migrate-refs": "tsx scripts/migrate-credential-refs.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1138.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "6.19.3",
    "dotenv": "^18.0.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.3",
    "zod": "^4.6.5"
  }
}
