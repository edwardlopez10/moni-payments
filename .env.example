# Runtime
NODE_ENV=development
# Deployment environment for secrets isolation (development | staging | production | test).
# Railway staging: NODE_ENV=production and APP_ENV=staging.
APP_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (docker compose maps host 5433 -> container 5432)
DATABASE_URL=postgresql://moniveo:moniveo@localhost:5433/moniveo_payments
TEST_DATABASE_URL=postgresql://moniveo:moniveo@localhost:5433/moniveo_payments_test

# Secrets resolution: env | memory | aws
# Under NODE_ENV=test, the factory defaults to memory when this is unset.
# staging/production APP_ENV requires SECRETS_PROVIDER=aws.
SECRETS_PROVIDER=env

# Required when SECRETS_PROVIDER=aws (leave unset for local env/memory):
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SECRETS_NAMESPACE_PREFIX=moniveo-payments/staging/
# SECRETS_KMS_KEY_ID=
# SECRETS_CACHE_TTL_SECONDS=60
# SECRETS_DELETION_RECOVERY_WINDOW_DAYS=7
# Age after which credential responses set credentialsStale (reporting only).
# CREDENTIALS_MAX_AGE_DAYS=90

# Fake provider credentials (resolved via credentialRefs on payment accounts)
FAKE_PROVIDER_API_KEY=dev-fake-api-key
FAKE_PROVIDER_WEBHOOK_SECRET=dev-fake-webhook-secret

# HMAC secret for signed callbacks to product backends (EventSubscription secretRef)
EVENT_CALLBACK_SECRET=dev-callback-secret

# Rate limits (requests per minute per IP)
RATE_LIMIT_MAX=300
WEBHOOK_RATE_LIMIT_MAX=120
