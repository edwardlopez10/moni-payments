meta {
  name: Create Payment Account
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/organizations/{{organizationId}}/payment-accounts
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{apiKey}}
  Idempotency-Key: bruno-acct-1
  Content-Type: application/json
}

body:json {
  {
    "provider": "fake",
    "providerMerchantId": "BRUNO-MERCHANT-001",
    "isDefault": true,
    "configuration": {
      "checkoutMode": "REDIRECT",
      "returnUrl": "http://localhost:3000/payments/return",
      "cancelUrl": "http://localhost:3000/payments/cancel"
    },
    "credentials": {
      "apiKey": "dev-fake-api-key",
    "webhookSecret": "dev-fake-webhook-secret"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("paymentAccountId", res.body.id);
  }
}
}
